<?xml version="1.0"?>
<package format="3">
  <name>seanav_deploy</name>
  <version>0.1.0</version>
  <description>SEA-Nav real-robot deployment: /rays and /pose publishers plus the controller entry.</description>
  <maintainer email="seanav@todo.todo">SEA-Nav Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
